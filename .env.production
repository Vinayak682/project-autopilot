# Production Environment
NEXT_PUBLIC_ENVIRONMENT=production
NEXT_PUBLIC_SUPABASE_URL=https://your-production-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=production-anon-key-here

# Anthropic API - Use production key
ANTHROPIC_API_KEY=sk-ant-v0-production-key-here

# Analytics - Enabled in production
NEXT_PUBLIC_GA_ID=G-PRODUCTION-ID

# Feature Flags
NEXT_PUBLIC_ENABLE_REALTIME=true
NEXT_PUBLIC_ENABLE_DEMOS=true
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_SENTRY=true

# API Configuration
NEXT_PUBLIC_API_TIMEOUT=60000
NEXT_PUBLIC_API_RETRY_COUNT=5

# Database
NEXT_PUBLIC_DB_LOG_QUERIES=false

# Sentry
NEXT_PUBLIC_SENTRY_DSN=https://your-production-sentry-dsn@sentry.io/production

# Cache
NEXT_PUBLIC_CACHE_TTL=3600

# Security
NEXT_PUBLIC_CSRF_ENABLED=true
