# Staging Environment
NEXT_PUBLIC_ENVIRONMENT=staging
NEXT_PUBLIC_SUPABASE_URL=https://your-staging-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=staging-anon-key-here

# Anthropic API - Use staging key
ANTHROPIC_API_KEY=sk-ant-v0-staging-key-here

# Analytics - Limited in staging
NEXT_PUBLIC_GA_ID=G-STAGING-ID

# Feature Flags
NEXT_PUBLIC_ENABLE_REALTIME=true
NEXT_PUBLIC_ENABLE_DEMOS=true
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_SENTRY=true

# API Configuration
NEXT_PUBLIC_API_TIMEOUT=30000
NEXT_PUBLIC_API_RETRY_COUNT=3

# Database
NEXT_PUBLIC_DB_LOG_QUERIES=false

# Sentry
NEXT_PUBLIC_SENTRY_DSN=https://your-staging-sentry-dsn@sentry.io/staging
